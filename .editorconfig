# Editor defaults for the repository. Every text file is UTF-8 with LF
# endings and a final newline; indentation depends on the language.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{lua,md,yaml,yml,json}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2
